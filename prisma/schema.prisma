// This file is the source of truth for the database schema.
// Run `prisma migrate dev` to apply changes once DATABASE_URL is configured.
//
// Note on UserProgram.isActive uniqueness:
// We cannot use @@unique([userId, isActive]) because it would prevent a user
// from having more than one inactive program. Instead, a partial unique index
// is applied via a raw SQL migration after the initial migrate:
//   CREATE UNIQUE INDEX "UserProgram_userId_isActive_partial_idx"
//   ON "UserProgram" ("userId") WHERE "isActive" = true;
//
// Note on UserProgram runs:
// Each UserProgram row is one RUN through a program, so a user may hold many
// rows per program. A run is "open" until it is completed (completedAt) or
// unsaved-with-history (archivedAt); both are terminal. At most one open run
// per (userId, programId) is enforced by a raw partial unique index:
//   CREATE UNIQUE INDEX "UserProgram_userId_programId_open_partial_idx"
//   ON "UserProgram" ("userId", "programId")
//   WHERE "completedAt" IS NULL AND "archivedAt" IS NULL;
//
// Note on WorkoutSession in-progress uniqueness (also raw SQL):
//   CREATE UNIQUE INDEX "WorkoutSession_userProgramId_in_progress_partial_idx"
//   ON "WorkoutSession" ("userProgramId") WHERE "status" = 'IN_PROGRESS';
//
// Note on Notification and User constraints (also raw SQL; see docs/notifications/SPEC-notifications.md):
//   CREATE INDEX "Notification_unread_idx" ON "Notification" ("recipientId")
//   WHERE "readAt" IS NULL AND "dismissedAt" IS NULL;
//   ALTER TABLE "Notification" ADD CONSTRAINT "Notification_actor_not_recipient"
//   CHECK ("actorId" IS NULL OR "actorId" <> "recipientId");
//   ALTER TABLE "User" ADD CONSTRAINT "User_workoutReminderMinute_range"
//   CHECK ("workoutReminderMinute" BETWEEN 0 AND 1439);

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum SessionStatus {
  IN_PROGRESS
  EDITING
  COMPLETED
}

enum ExerciseGroupType {
  STANDARD
  SUPERSET
}

enum Platform {
  IOS
}

enum PushEnvironment {
  SANDBOX
  PRODUCTION
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

// Why a post or user was reported (docs/social/SPEC-reports.md).
enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  SEXUAL_CONTENT
  VIOLENCE
  SELF_HARM
  IMPERSONATION
  OTHER
}

// What a post shares (docs/social/SPEC-workout-shares.md).
enum WorkoutShareKind {
  PROGRAM
  STANDALONE
}

// What an inbox notification is about (docs/notifications/SPEC-notifications.md).
enum NotificationType {
  FOLLOW_REQUEST
  NEW_FOLLOWER
  FOLLOW_ACCEPTED
  POST_REACTION
  WORKOUT_REMINDER
  WORKOUT_UNFINISHED
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

// Which day a scheduled-workout reminder fires on, relative to the workout
// (docs/notifications/SPEC-notifications.md). The time is workoutReminderMinute.
enum WorkoutReminderDay {
  SAME_DAY
  DAY_BEFORE
}

enum WeekStartDay {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

// ---------------------------------------------------------------------------
// Auth / User
// ---------------------------------------------------------------------------

model User {
  id                       String             @id @default(cuid())
  email                    String             @unique
  name                     String?
  avatarUrl                String?
  ptRoutineInWorkout       Boolean            @default(false)
  /// Social privacy: who may see this user's posts (docs/social/SPEC-follows.md).
  profileVisibility        ProfileVisibility  @default(PRIVATE)
  /// Unique handle, stored lowercase (docs/social/SPEC-usernames.md). Every
  /// account has one: generated at sign-up (user_ + 6 digits), changeable,
  /// never cleared. Raw CHECKs in the migration enforce the format.
  username                 String             @unique
  /// Optional profile bio, at most 100 characters (raw CHECK).
  bio                      String?
  /// Profile stats (docs/social/SPEC-profile-stats.md, ADR 001 amendment):
  /// shown to whoever can see the user's posts; the owner always sees both.
  showActiveProgram        Boolean            @default(true)
  showWorkoutCount         Boolean            @default(true)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  /// IANA zone, e.g. "America/Chicago", sent by the client; used for workout reminders.
  timezone                 String?
  /// Local minutes after midnight at which scheduled-workout reminders fire; 480 = 08:00.
  workoutReminderMinute    Int                @default(480)
  /// The day that time falls on: the workout's own date, or the day before.
  workoutReminderDay       WorkoutReminderDay @default(SAME_DAY)
  /// Weekly workout goal (docs/weekly-goal/SPEC-weekly-goal.md). Private to the owner.
  weeklyWorkoutGoalEnabled Boolean            @default(false)
  /// Kept while disabled so re-enabling restores it; raw CHECK 1–7.
  weeklyWorkoutGoal        Int                @default(3)
  /// First day of the user's week, for the weekly goal and the dashboard's "this week".
  weekStartDay             WeekStartDay       @default(SUNDAY)

  identities                Identity[]
  userPrograms              UserProgram[]
  workoutSessions           WorkoutSession[]
  standaloneWorkoutSessions StandaloneWorkoutSession[]
  feedback                  Feedback[]
  userExerciseNotes         UserExerciseNote[]
  refreshTokens             RefreshToken[]
  deviceTokens              DeviceToken[]
  ptRoutines                PtRoutine[]
  blocksMade                UserBlock[]                @relation("BlocksMade")
  blocksReceived            UserBlock[]                @relation("BlocksReceived")
  following                 Follow[]                   @relation("Following")
  followers                 Follow[]                   @relation("Followers")
  posts                     Post[]
  postPhotos                PostPhoto[]
  postReactions             PostReaction[]
  reportsMade               Report[]                   @relation("ReportsMade")
  reportsReceived           Report[]                   @relation("ReportsReceived")
  notificationsReceived     Notification[]             @relation("NotificationsReceived")
  notificationsCaused       Notification[]             @relation("NotificationsCaused")
  notificationPreferences   NotificationPreference[]
}

model Identity {
  id         String   @id @default(cuid())
  userId     String
  provider   String
  providerId String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  deviceInfo String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeviceToken {
  id          String          @id @default(cuid())
  userId      String
  token       String
  platform    Platform
  environment PushEnvironment
  createdAt   DateTime        @default(now())
  lastSeenAt  DateTime?
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token, environment])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Program library (immutable definitions)
// ---------------------------------------------------------------------------

model Program {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  weeks        ProgramWeek[]
  userPrograms UserProgram[]
}

model ProgramWeek {
  id         String @id @default(cuid())
  programId  String
  weekNumber Int

  program Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  days    ProgramDay[]

  @@unique([programId, weekNumber])
}

model ProgramDay {
  id            String  @id @default(cuid())
  programWeekId String
  dayNumber     Int
  name          String?
  warmUp        String?

  programWeek    ProgramWeek     @relation(fields: [programWeekId], references: [id], onDelete: Cascade)
  exerciseGroups ExerciseGroup[]

  @@unique([programWeekId, dayNumber])
}

model ExerciseGroup {
  id           String            @id @default(cuid())
  programDayId String
  order        Int
  type         ExerciseGroupType @default(STANDARD)
  restSeconds  Int?

  programDay ProgramDay        @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  exercises  ProgramExercise[]

  @@unique([programDayId, order])
}

model Exercise {
  id            String  @id @default(cuid())
  name          String  @unique
  slug          String  @unique // URL-safe, derived from name at creation (shared/utils/slug.ts); write-once
  description   String?
  isCore        Boolean @default(false)
  videoUrl      String? // YouTube demonstration link
  animationPath String? // object key in the PRIVATE exercise-media bucket — never a URL; the API signs it on read
  posterPath    String? // still frame for animationPath, same bucket and key scheme

  programExercises           ProgramExercise[]
  userExerciseNotes          UserExerciseNote[]
  originalSwaps              WorkoutExerciseSwap[]       @relation("OriginalSwaps")
  replacementSwaps           WorkoutExerciseSwap[]       @relation("ReplacementSwaps")
  coreWorkoutExercises       CoreWorkoutExercise[]
  standaloneWorkoutExercises StandaloneWorkoutExercise[]
}

model UserExerciseNote {
  id         String   @id @default(cuid())
  userId     String
  exerciseId String
  notes      String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
}

model ProgramExercise {
  id              String @id @default(cuid())
  exerciseGroupId String
  exerciseId      String
  order           Int

  exercise             Exercise              @relation(fields: [exerciseId], references: [id])
  exerciseGroup        ExerciseGroup         @relation(fields: [exerciseGroupId], references: [id], onDelete: Cascade)
  sets                 ExerciseSet[]
  completedSets        CompletedSet[]
  workoutExerciseSkips WorkoutExerciseSkip[]

  @@unique([exerciseGroupId, order])
}

model ExerciseSet {
  id                String  @id @default(cuid())
  programExerciseId String
  setNumber         Int
  reps              Int?
  weight            Float?
  rpe               Float?
  notes             String?
  effortTarget      String?

  programExercise ProgramExercise @relation(fields: [programExerciseId], references: [id], onDelete: Cascade)
  completedSets   CompletedSet[]

  @@unique([programExerciseId, setNumber])
}

// ---------------------------------------------------------------------------
// User progress (mutable)
// ---------------------------------------------------------------------------

model UserProgram {
  id          String    @id @default(cuid())
  userId      String
  programId   String
  isActive    Boolean   @default(false)
  currentWeek Int       @default(1)
  currentDay  Int       @default(1)
  startedAt   DateTime  @default(now())
  // Set when the final day of the program is completed, or when the user ends
  // the run early (PATCH /api/user-programs/:id/complete). Terminal.
  completedAt DateTime?
  // Set when the user unsaves a run that has completed workouts: the run leaves
  // the library but its history is kept. Terminal — never un-archived.
  archivedAt  DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  workoutSessions   WorkoutSession[]
  scheduledWorkouts ScheduledWorkout[]

  @@index([userId, programId])
}

model WorkoutSession {
  id            String        @id @default(cuid())
  userId        String
  userProgramId String
  weekNumber    Int
  dayNumber     Int
  status        SessionStatus @default(IN_PROGRESS)
  startedAt     DateTime      @default(now())
  completedAt   DateTime?
  notes         String?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userProgram UserProgram @relation(fields: [userProgramId], references: [id], onDelete: Cascade)

  completedSets        CompletedSet[]
  workoutExerciseSwaps WorkoutExerciseSwap[]
  workoutExerciseSkips WorkoutExerciseSkip[]
  coreWorkout          CoreWorkout?
  sharedInPost         Post?
  notifications        Notification[]

  // Serves the profile's completed-workout count (docs/social/SPEC-profile-stats.md).
  @@index([userId, status])
}

model CompletedSet {
  id                String   @id @default(cuid())
  workoutSessionId  String
  exerciseSetId     String?
  programExerciseId String?
  adhocExerciseName String?
  reps              Int?
  weight            Float?
  rpe               Float?
  notes             String?
  completedAt       DateTime @default(now())

  workoutSession  WorkoutSession   @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exerciseSet     ExerciseSet?     @relation(fields: [exerciseSetId], references: [id], onDelete: Cascade)
  programExercise ProgramExercise? @relation(fields: [programExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutSessionId, exerciseSetId])
  @@index([workoutSessionId, programExerciseId])
  // Single-column index for FK lookups by programExerciseId alone; created by
  // migration 20260416000000 but previously undeclared here (schema drift).
  @@index([programExerciseId])
}

// A timed core circuit the user assembles inside a live workout session.
// timeSeconds/restSeconds are global to the circuit; each entry is exactly one
// work interval, so the number of entries is the number of "sets". The timer
// runs client-side — the server persists only the plan and an optional
// completion timestamp. Time bounds are also enforced by raw-SQL CHECK
// constraints matching the API contract (timeSeconds 1..3600, restSeconds
// 0..3600).
model CoreWorkout {
  id               String    @id @default(cuid())
  workoutSessionId String    @unique
  timeSeconds      Int
  restSeconds      Int
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workoutSession WorkoutSession        @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercises      CoreWorkoutExercise[]
}

model CoreWorkoutExercise {
  id            String @id @default(cuid())
  coreWorkoutId String
  exerciseId    String
  order         Int

  coreWorkout CoreWorkout @relation(fields: [coreWorkoutId], references: [id], onDelete: Cascade)
  exercise    Exercise    @relation(fields: [exerciseId], references: [id])

  @@unique([coreWorkoutId, order])
}

model WorkoutExerciseSwap {
  id                    String   @id @default(cuid())
  workoutSessionId      String
  programExerciseId     String
  originalExerciseId    String
  replacementExerciseId String
  createdAt             DateTime @default(now())

  workoutSession      WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  originalExercise    Exercise       @relation("OriginalSwaps", fields: [originalExerciseId], references: [id])
  replacementExercise Exercise       @relation("ReplacementSwaps", fields: [replacementExerciseId], references: [id])

  @@unique([workoutSessionId, programExerciseId])
}

// Marks a ProgramExercise as skipped for one session. A skip hides the slot
// from session reads; it does not change exercise identity, so an existing
// WorkoutExerciseSwap for the slot is preserved and re-applies on un-skip.
model WorkoutExerciseSkip {
  id                String   @id @default(cuid())
  workoutSessionId  String
  programExerciseId String
  createdAt         DateTime @default(now())

  workoutSession  WorkoutSession  @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  programExercise ProgramExercise @relation(fields: [programExerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutSessionId, programExerciseId])
  @@index([programExerciseId])
}

model ScheduledWorkout {
  id            String   @id @default(cuid())
  userProgramId String
  weekNumber    Int
  dayNumber     Int
  scheduledDate DateTime @db.Date
  createdAt     DateTime @default(now())

  userProgram   UserProgram    @relation(fields: [userProgramId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([userProgramId, weekNumber, dayNumber])
  @@unique([userProgramId, scheduledDate])
}

// ---------------------------------------------------------------------------
// Feedback
// ---------------------------------------------------------------------------

model Feedback {
  id             String   @id @default(cuid())
  userId         String
  content        String
  screenshotPath String?
  addressed      Boolean  @default(false)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Standalone workouts (on-demand, program-independent)
//
// Short "on the go" workouts a user can start and finish without touching any
// program's progress. Definitions mirror the program hierarchy
// (StandaloneWorkout → Group → Exercise → Set) and reuse the shared Exercise
// catalog. Sessions live in their own tables (StandaloneWorkoutSession /
// StandaloneCompletedSet) so completing one can never advance a UserProgram.
//
// Note on StandaloneWorkoutSession in-progress uniqueness:
// A partial unique index enforces at most one IN_PROGRESS session per
// (userId, standaloneWorkoutId); it is applied via raw SQL in the migration
// because Prisma cannot express partial indexes:
//   CREATE UNIQUE INDEX "StandaloneWorkoutSession_in_progress_partial_idx"
//   ON "StandaloneWorkoutSession" ("userId", "standaloneWorkoutId")
//   WHERE "status" = 'IN_PROGRESS';
// ---------------------------------------------------------------------------

model StandaloneWorkout {
  id          String   @id @default(cuid())
  category    String
  order       Int
  name        String?
  description String?
  createdAt   DateTime @default(now())

  groups   StandaloneWorkoutGroup[]
  sessions StandaloneWorkoutSession[]

  @@unique([category, order])
}

model StandaloneWorkoutGroup {
  id                  String            @id @default(cuid())
  standaloneWorkoutId String
  order               Int
  type                ExerciseGroupType @default(STANDARD)
  label               String?
  restSeconds         Int?

  standaloneWorkout StandaloneWorkout           @relation(fields: [standaloneWorkoutId], references: [id], onDelete: Cascade)
  exercises         StandaloneWorkoutExercise[]

  @@unique([standaloneWorkoutId, order])
}

model StandaloneWorkoutExercise {
  id         String @id @default(cuid())
  groupId    String
  exerciseId String
  order      Int

  group    StandaloneWorkoutGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  exercise Exercise               @relation(fields: [exerciseId], references: [id])
  sets     StandaloneWorkoutSet[]

  @@unique([groupId, order])
}

model StandaloneWorkoutSet {
  id                          String  @id @default(cuid())
  standaloneWorkoutExerciseId String
  setNumber                   Int
  reps                        Int?
  weight                      Float?
  rpe                         Float?
  notes                       String?
  effortTarget                String?

  standaloneWorkoutExercise StandaloneWorkoutExercise @relation(fields: [standaloneWorkoutExerciseId], references: [id], onDelete: Cascade)
  completedSets             StandaloneCompletedSet[]

  @@unique([standaloneWorkoutExerciseId, setNumber])
}

model StandaloneWorkoutSession {
  id                  String        @id @default(cuid())
  userId              String
  standaloneWorkoutId String
  status              SessionStatus @default(IN_PROGRESS)
  startedAt           DateTime      @default(now())
  completedAt         DateTime?
  notes               String?

  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  standaloneWorkout StandaloneWorkout        @relation(fields: [standaloneWorkoutId], references: [id], onDelete: Cascade)
  completedSets     StandaloneCompletedSet[]
  sharedInPost      Post?
  notifications     Notification[]

  @@index([userId])
  @@index([standaloneWorkoutId])
  // Serves the profile's completed-workout count (docs/social/SPEC-profile-stats.md).
  @@index([userId, status])
}

model StandaloneCompletedSet {
  id                         String   @id @default(cuid())
  standaloneWorkoutSessionId String
  standaloneWorkoutSetId     String?
  adhocExerciseName          String?
  reps                       Int?
  weight                     Float?
  rpe                        Float?
  notes                      String?
  completedAt                DateTime @default(now())

  session StandaloneWorkoutSession @relation(fields: [standaloneWorkoutSessionId], references: [id], onDelete: Cascade)
  set     StandaloneWorkoutSet?    @relation(fields: [standaloneWorkoutSetId], references: [id], onDelete: Cascade)

  @@unique([standaloneWorkoutSessionId, standaloneWorkoutSetId], map: "StandaloneCompletedSet_session_set_key")
  @@index([standaloneWorkoutSessionId])
}

// ---------------------------------------------------------------------------
// PT Routines
// ---------------------------------------------------------------------------

// User-authored physical-therapy routines: a named, ordered list of
// presentational exercises (no tracking/completion). Each exercise carries
// exactly one measure — durationSeconds XOR reps — enforced by raw-SQL CHECK
// constraints alongside app-layer validation (duration 1..3600, reps 1..1000).
model PtRoutine {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises PtRoutineExercise[]

  @@index([userId])
}

model PtRoutineExercise {
  id              String @id @default(cuid())
  ptRoutineId     String
  order           Int
  title           String
  durationSeconds Int?
  reps            Int?

  ptRoutine PtRoutine @relation(fields: [ptRoutineId], references: [id], onDelete: Cascade)

  @@unique([ptRoutineId, order])
}

// ---------------------------------------------------------------------------
// Social
//
// See docs/social/CAPABILITY_MAP.md. A block hides each user from the other
// everywhere in the social surface and is never disclosed to the blocked user.
// ---------------------------------------------------------------------------

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// A text post. Who may see it is decided by its author's profile, in one place:
// `canViewPostsBy` in server/utils/posts.ts (docs/social/SPEC-follows.md). Deletes are hard; later
// social tables (photos, reactions) cascade from here.
model Post {
  id        String    @id @default(cuid())
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  /// Set when the post shares a workout. With sharedProgramName, a snapshot
  /// taken at creation, so the share text survives the session being deleted.
  sharedWorkoutKind   WorkoutShareKind?
  /// The program's name when shared (PROGRAM only).
  sharedProgramName   String?
  /// Once-per-session guards; nulled if the session is deleted.
  workoutSessionId    String?           @unique
  standaloneSessionId String?           @unique

  author            User                      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  photos            PostPhoto[]
  reactions         PostReaction[]
  reports           Report[]
  notifications     Notification[]
  workoutSession    WorkoutSession?           @relation(fields: [workoutSessionId], references: [id], onDelete: SetNull)
  standaloneSession StandaloneWorkoutSession? @relation(fields: [standaloneSessionId], references: [id], onDelete: SetNull)

  // Serves a profile's posts and the feed: posts by these authors, newest first.
  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)])
}

// One row per direction: A following B and B following A are independent.
// Following a PUBLIC profile is ACCEPTED at once; a PRIVATE one starts PENDING
// until the followee accepts. Unfollowing, cancelling and declining delete the
// row, so "may see their posts" is exactly "an ACCEPTED row exists" (or the
// profile is PUBLIC). Raw SQL CHECK in the migration:
//   CHECK ("followerId" <> "followeeId")
model Follow {
  id         String       @id @default(cuid())
  followerId String
  followeeId String
  status     FollowStatus
  createdAt  DateTime     @default(now())
  acceptedAt DateTime?

  follower User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("Followers", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId, status])
}

// A photo on a post, already processed: orientation baked in, ALL metadata
// (EXIF/GPS) stripped, ≤2048px, JPEG (server/utils/post-photos.ts). The bytes
// live in the PRIVATE `post-photos` Storage bucket at `storagePath`; reads sign
// them for 15 minutes. Uploaded first (postId null), then attached when the
// post is created; fixed from then on. Raw SQL CHECK in the migration:
//   CHECK ((postId IS NULL AND position IS NULL) OR
//          (postId IS NOT NULL AND position IS NOT NULL AND position BETWEEN 0 AND 3))
model PostPhoto {
  id          String   @id @default(cuid())
  uploaderId  String
  postId      String?
  position    Int?
  storagePath String   @unique
  width       Int
  height      Int
  createdAt   DateTime @default(now())

  uploader User  @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  post     Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, position])
  @@index([uploaderId, postId])
}

// An emoji reaction (docs/social/SPEC-reactions.md). A user may add several
// DIFFERENT emoji to one post (at most 10), each once. `emoji` is a single,
// fully-qualified RGI emoji, normalized by parseReactionEmoji (so ❤ and ❤️ are
// the same reaction). The (postId, emoji, createdAt, id) index serves both the
// per-emoji counts and the newest-first who-reacted pages.
model PostReaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
  @@index([postId, emoji, createdAt(sort: Desc), id(sort: Desc)])
}

// A report of a post or a user, kept for moderation (docs/social/SPEC-reports.md).
// There is no moderation API: a moderator resolves rows in SQL
// (docs/social/MODERATION.md). Raw SQL in the migration:
//   - partial unique indexes: one report per reporter per post, and per
//     reporter per user (user reports only), so a repeat is a no-op
//   - CHECK ("reporterId" <> "reportedUserId")
//   - CHECK octet_length limits on details and resolution
model Report {
  id             String       @id @default(cuid())
  reporterId     String
  /// The user reported, or the reported post's author. Always set.
  reportedUserId String
  /// Set for a post report; nulled if the post is deleted (the snapshot stays).
  postId         String?
  /// True for a post report, so it stays one after postId is nulled.
  isPostReport   Boolean
  reason         ReportReason
  details        String?
  /// What was reported, captured at report time: a post's { body, photoCount,
  /// sharedWorkout } or a user's { name, avatarUrl }.
  snapshot       Json
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?
  resolution     String?

  reporter     User  @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User  @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)
  post         Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  // The moderation queue: unresolved first, oldest first.
  @@index([resolvedAt, createdAt])
  @@index([reportedUserId])
}

// An inbox item for one recipient, with push delivery state. followId has no FK:
// Follow rows are hard-deleted and retraction is done explicitly in code.
// See docs/notifications/SPEC-notifications.md.
model Notification {
  id                  String           @id @default(cuid())
  recipientId         String
  type                NotificationType
  actorId             String?
  postId              String?
  followId            String?
  workoutSessionId    String?
  standaloneSessionId String?
  scheduledWorkoutId  String?
  data                Json             @default("{}")
  dedupeKey           String           @unique
  createdAt           DateTime         @default(now())
  readAt              DateTime?
  dismissedAt         DateTime?
  pushedAt            DateTime?
  pushAttempts        Int              @default(0)

  recipient         User                      @relation("NotificationsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  actor             User?                     @relation("NotificationsCaused", fields: [actorId], references: [id], onDelete: Cascade)
  post              Post?                     @relation(fields: [postId], references: [id], onDelete: Cascade)
  workoutSession    WorkoutSession?           @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  standaloneSession StandaloneWorkoutSession? @relation(fields: [standaloneSessionId], references: [id], onDelete: Cascade)
  scheduledWorkout  ScheduledWorkout?         @relation(fields: [scheduledWorkoutId], references: [id], onDelete: Cascade)

  @@index([recipientId, dismissedAt, createdAt(sort: Desc), id(sort: Desc)])
  // Supports the block cleanup (deleteMany by actor/recipient pair).
  @@index([actorId])
  @@index([followId])
}

// One row per (user, type) the user changed; a missing row means push is enabled.
// See docs/notifications/SPEC-notifications.md.
model NotificationPreference {
  userId      String
  type        NotificationType
  pushEnabled Boolean
  updatedAt   DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
}
