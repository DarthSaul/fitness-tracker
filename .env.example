# Database — Supabase PostgreSQL
# Pooled connection for app runtime (port 6543, must include ?pgbouncer=true)
DATABASE_URL=
# Direct connection for migrations (port 5432, bypasses PgBouncer)
DIRECT_URL=

# Supabase — project URL and service role key (server-only, never exposed to browser)
# URL: Supabase Dashboard > Settings > API > Project URL
# Service role key: Supabase Dashboard > Settings > API > service_role (secret)
NUXT_SUPABASE_SERVICE_ROLE_KEY=
NUXT_SUPABASE_URL=

# Session — encrypts auth cookies (generate: openssl rand -base64 32)
NUXT_SESSION_PASSWORD=

# Google OAuth — Google Cloud Console > APIs & Services > Credentials
# The consent screen must be PUBLISHED (not "Testing") or only listed test
# users can sign in, regardless of what the server allows.
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Apple OAuth (web) — developer.apple.com. Distinct from the native iOS flow,
# which uses NUXT_APPLE_BUNDLE_ID below. Requires a Services ID with the
# production Return URL https://<domain>/api/auth/apple plus a Sign in with
# Apple key (.p8).
#
# The login screen hides the Apple button unless ALL FIVE below are set — a
# partial configuration fails just as hard as none at all. CLIENT_ID (the
# Services ID, not the bundle ID), TEAM_ID, KEY_ID and PRIVATE_KEY mint the
# client secret; REDIRECT_URL is sent verbatim at the token exchange with no
# fallback, so omitting it returns `invalid_grant` after the user has already
# consented. Override without a rebuild via NUXT_PUBLIC_APPLE_AUTH_ENABLED.
NUXT_OAUTH_APPLE_CLIENT_ID=
NUXT_OAUTH_APPLE_TEAM_ID=
NUXT_OAUTH_APPLE_KEY_ID=
NUXT_OAUTH_APPLE_PRIVATE_KEY=
NUXT_OAUTH_APPLE_REDIRECT_URL=

# JWT — for native iOS client auth
# Generate secrets: openssl rand -base64 48
NUXT_JWT_ACCESS_SECRET=
NUXT_JWT_REFRESH_SECRET=
# Optional: enables refresh token rotation on every use
NUXT_JWT_REFRESH_ROTATION=true

# Native iOS sign-in
# iOS app bundle ID (e.g. com.example.fitnesstracker) — used as JWT audience for Sign in with Apple
NUXT_APPLE_BUNDLE_ID=
# Google OAuth client ID for iOS (iOS client from Google Cloud Console)
NUXT_GOOGLE_IOS_CLIENT_ID=

# APNs push notifications
# 10-char Apple Team ID from developer.apple.com
NUXT_APNS_TEAM_ID=
# 10-char Key ID from developer.apple.com
NUXT_APNS_KEY_ID=
# base64-encoded .p8 key: base64 -i AuthKey_XXXXXXXX.p8 | tr -d '\n'
NUXT_APNS_PRIVATE_KEY=

# CORS — production web frontend origin (no trailing slash, no wildcard)
NUXT_PUBLIC_APP_URL=

# Rate limiting — provision via Vercel KV integration (Upstash Redis)
# No-ops safely when absent; add to Vercel project when ready for production limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry — DSN provisioned via Sentry's Vercel integration (no NUXT_ prefix; read directly from process.env)
# When SENTRY_DSN is unset, Sentry init is skipped silently — safe default for local dev.
SENTRY_DSN=
# Source map upload — set in Vercel project env only, never commit. Required for readable stack traces.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional override for performance tracing sample rate. Defaults: 0.2 in production, 1.0 elsewhere.
SENTRY_TRACES_SAMPLE_RATE=
